From 3fc527da4ae10f0f424d09585541632031f55d6e Mon Sep 17 00:00:00 2001
From: tangyongjie <80395553+yongjieTang@users.noreply.github.com>
Date: Fri, 21 Nov 2025 15:37:27 +0800
Subject: [PATCH] adapt v8 of verison 14

---
 src/napi/v8/js_native_api_v8.cc   | 2 +-
 src/napi/v8/js_native_api_v8.cc.h | 8 ++++----
 2 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/src/napi/v8/js_native_api_v8.cc b/src/napi/v8/js_native_api_v8.cc
index f3e40cd..c55b3c7 100644
--- a/src/napi/v8/js_native_api_v8.cc
+++ b/src/napi/v8/js_native_api_v8.cc
@@ -27,7 +27,7 @@ static napi_status napi_run_script(napi_env env, const char* script,
   if (filename) {
     v8::Local<v8::Value> origin_string;
     CHECK_NEW_FROM_UTF8(env, origin_string, filename);
-    v8::ScriptOrigin so(env->ctx->isolate, origin_string);
+    v8::ScriptOrigin so(origin_string);
     maybe_script = v8::Script::Compile(context, v8_script, &so);
   } else {
     maybe_script = v8::Script::Compile(context, v8_script);
diff --git a/src/napi/v8/js_native_api_v8.cc.h b/src/napi/v8/js_native_api_v8.cc.h
index 696b863..678969f 100644
--- a/src/napi/v8/js_native_api_v8.cc.h
+++ b/src/napi/v8/js_native_api_v8.cc.h
@@ -486,7 +486,7 @@ inline static napi_status Unwrap(napi_env env, napi_value js_object,
 
   auto val = obj->GetInternalField(0);
 
-  if (!val->IsExternal()) {
+  if (!val->IsValue() || !val.As<v8::Value>()->IsExternal()) {
     if (result) {
       *result = nullptr;
     }
@@ -733,7 +733,8 @@ inline napi_status Wrap(napi_env env, napi_value js_object, void* native_object,
 
   if (wrap_type == retrievable) {
     // If we've already wrapped this object, we error out.
-    RETURN_STATUS_IF_FALSE(env, obj->GetInternalField(0)->IsUndefined(),
+    auto field = obj->GetInternalField(0);
+    RETURN_STATUS_IF_FALSE(env, field->IsValue() && field.As<v8::Value>()->IsUndefined(),
                            napi_invalid_arg);
   } else if (wrap_type == anonymous) {
     // If no finalize callback is provided, we error out.
@@ -990,8 +991,7 @@ napi_status napi_define_class(napi_env env, const char* utf8name, size_t length,
       }
 
       tpl->PrototypeTemplate()->SetAccessorProperty(property_name, getter_tpl,
-                                                    setter_tpl, attributes,
-                                                    v8::AccessControl::DEFAULT);
+                                                    setter_tpl, attributes);
     } else if (p->method != nullptr) {
       v8::Local<v8::Value> cbdata =
           v8impl::CreateFunctionCallbackData(env, p->method, p->data);
-- 
